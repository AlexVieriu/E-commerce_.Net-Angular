<Project>

  <!-- C# / Roslyn analyzers only — ESLint + Prettier are separate (client/eslint.config.js).
       Applies to src/** automatically; tests/** only via the Import in tests/Directory.Build.props. -->
  <PropertyGroup>

    <!-- Analyzers already run by default, but only a handful of rules are warnings. Recommended adds many. -->
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Runs the IDExxxx style rules at build. Inert until .editorconfig raises one to warning/error. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- The teeth: a CA violation is only a warning by default, so the build would still pass.
         CI builds Release, dev builds Debug — a warning fails the PR without blocking you mid-edit. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

  </PropertyGroup>

</Project>

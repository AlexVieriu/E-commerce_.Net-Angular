<Project>

  <!-- C# / Roslyn analyzers only — ESLint + Prettier are separate (client/eslint.config.js).
       Reaches src/** automatically; tests/** only via the Import in tests/Directory.Build.props. -->
  <PropertyGroup>

    <!-- Analyzers already run; by default only a handful of rules warn. Recommended turns on many more. -->
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Lets IDExxxx style rules reach the build (IDE-only otherwise).
         Needs BOTH switches: this one AND a warning/error severity in .editorconfig — a rule left at
         `suggestion` never fails a build. Live today for IDE1006 (naming). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- The teeth: a CA violation is only a warning, so the build would still pass without this.
         Release-only, and CI builds Release — so a warning fails the PR but not your local edit loop.
         `-c Release` arrives as a global property, already set this early. 
         With no flag, $(Configuration) is EMPTY here (the "Debug" default is assigned later), 
         so '' != 'Release' and the teeth stay off.
         The single quotes are load-bearing: MSBuild requires them to compare an empty value. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

  </PropertyGroup>

</Project>
